{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noResolveJsonModule": false,
    "noImplicitAny": false
  },
  "exclude": ["node_modules", "dist"],
  "include": ["**/*.ts"]
}
