# Local Environment Variables for DineSmart SaaS
NODE_ENV=development
PORT=3000

# MongoDB Connection String
# - Local MongoDB instance: mongodb://127.0.0.1:27017/dinesmart
# - MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/dinesmart?retryWrites=true&w=majority
# - Note: If local mongod is not running, DineSmart automatically activates its dynamic in-memory store so the app works seamlessly.
MONGODB_URI="mongodb://127.0.0.1:27017/dinesmart"

# Gemini AI API Key (Server-side key for smart menu suggestions & AI analytics)
GEMINI_API_KEY=""
